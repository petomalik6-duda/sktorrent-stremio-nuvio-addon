PORT=7000
# Optional server-wide TMDB key. A user can also enter a key on /configure.
TMDB_API_KEY=
# Optional public URL, e.g. https://my-sktorrent-addon.onrender.com
PUBLIC_URL=
# Catalog HTML cache in seconds
CACHE_TTL_SECONDS=600

# Optional operator-owned HTTPS video URLs keyed by exact infoHash:fileIdx.
DIRECT_STREAMS_JSON={}
